{
    // 2026-10-14 修：原来两个任务都写死了上一台机器的路径 ——
    //   * 默认构建任务指向一个**本机并不存在的 mingw gcc**（本工程用的是 CMake + arm-none-eabi，
    //     那个单文件 gcc 任务本来就是 VS Code 自动生成的残留）；
    //   * 烧录任务用裸 "bash"，而本机 bash 不在 PATH 里（Git Bash 装在 %ProgramFiles%\Git）。
    // 现在都改成用环境变量定位工具，换机器不用再改。
    // （注：注释里也不写具体的盘符路径 —— .vscode 下的内容会被 githooks/pre-commit 扫，
    //   写了 D:\Program Files\... 之类会触发它的"软提醒"。）
    "version": "2.0.0",
    "tasks": [
        {
            // 默认构建（Ctrl+Shift+B）：直接驱动已有的 CMake 构建目录，
            // 生成器/编译器都从 build/Debug/CMakeCache.txt 里取，不需要 ninja/gcc 在 PATH 上。
            "label": "Build: CMake Debug",
            "type": "shell",
            "command": "${env:CUBE_BUNDLE_PATH}/cmake/4.3.1+st.1/bin/cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}/build/Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "cmake --build build/Debug（arm-none-eabi-gcc，0 警告是验收标准）"
        },
        {
            // 无线 DAPLink 烧录（重试版）：脚本里写清了为什么不带 reset、
            // 为什么调 SWCLK 没用。Git Bash 按标准安装位置取。
            "label": "Flash: 无线 DAPLink 重试烧录",
            "type": "shell",
            "command": "${env:ProgramFiles}/Git/bin/bash.exe",
            "args": [
                "${workspaceFolder}/.vscode/flash-retry.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "detail": "openocd 重试烧录（默认 30 次）。可用 ATTEMPTS=5 bash .vscode/flash-retry.sh 改次数"
        }
    ]
}
