{
    // 使用 IntelliSense 了解相关属性。
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        // ── 默认配置：无线 DAPLink（CMSIS-DAP）────────────────────────────
        // 本工程的调试器是无线 DAPLink，**没有 ST-Link**，所以把这条放第一位，
        // 按 F5 / 点调试按钮直接走它。
        //
        // 排在第一位的意义：之前那个
        //   "bound doStepConnectToTarget Failed: could not connect (error 138)"
        // 就是默认走了下面的 ST-Link 配置导致的。那个 138 是
        // ERROR_JOIN_TO_JOIN（文件系统错误码），属于扩展在"连不上 GDB Server"
        // 时抛出的假错误码，不代表真实原因，别被它带偏。
        //
        // 若这条路也报连不上，用重试脚本（链路本身间歇性丢包，脚本里记了原因）：
        //   bash .vscode/flash-retry.sh
        {
            "name": "Debug with Wireless DAP (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/STM32F407_CAN_CMD.elf",
            "armToolchainPath": "C:/Users/Dawn/AppData/Local/stm32cube/bundles/gnu-gdb-for-stm32/14.3.1+st.2/bin",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32f4x.cfg"
            ],
            "device": "STM32F407VE",
            "interface": "swd",
            "openOCDLaunchCommands": [
                "transport select swd"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "svdFile": "C:/Users/Dawn/AppData/Local/stm32cube/packs/STMicroelectronics/stm32f4xx_dfp/1.2.0/SVD/STM32F407.svd"
        },

        // ── 备用配置：接上 ST-Link 时用 ──────────────────────────────────
        // ST-LINK_gdbserver 只认 ST-Link。没接 ST-Link 时选它会报
        // "could not connect (error 138)"，原因就是没接，不是工程有问题。
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ]
        }
    ]
}
