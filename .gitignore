# CLion
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#cmake-build-*

# Build output (CMake build tree, any depth)
build/
cmake-build-*/

# Firmware output files (fallback, in case generated outside build/)
*.elf
*.map
*.hex
*.bin
*.list

# STM32CubeIDE / ST VS Code extension workspace caches
.settings/

# STM32CubeMX generated metadata (regenerated by CubeMX, contains machine-specific paths)
.mxproject

# AI tool local state / indexes
.clangd/
.codegraph/
.omo/
.claude/
.workbuddy/

# IDE
.idea/

# OS junk
Thumbs.db
.DS_Store
